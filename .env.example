# TRUST AI — variables d'environnement.
# L'application fonctionne et se compile SANS AUCUNE de ces variables
# (mode démonstration). Ne jamais mettre de vraies valeurs dans ce fichier.

# URL publique de l'application
NEXT_PUBLIC_APP_URL=

# ---------------------------------------------------------------------------
# Supabase — mode connecté (voir docs/SUPABASE_SETUP.md)
# Seules ces DEUX clés publiques sont nécessaires côté application.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Variables SERVEUR (sans préfixe NEXT_PUBLIC_ : jamais envoyées au
# navigateur). À renseigner UNIQUEMENT dans Vercel / .env.local — ne JAMAIS
# committer une vraie valeur, ni la coller dans une conversation.
# ---------------------------------------------------------------------------

# Clé secrète Supabase (Settings → API Keys → Secret key) : utilisée par les
# routes serveur (webhooks Shopify, synchronisation catalogue) uniquement.
# OBLIGATOIRE pour l'intégration Shopify.
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Shopify — parcours actuel 2026 (application Dev Dashboard, voir
# docs/SHOPIFY_SETUP.md). L'application obtient elle-même ses access tokens
# (Client Credentials Grant, renouvelés automatiquement toutes les 24 h) et
# le Client Secret sert aussi à vérifier la signature HMAC des webhooks.
# ---------------------------------------------------------------------------
# OBLIGATOIRE — domaine(s) technique(s) de la boutique. Utilise le domaine
# envoyé par Shopify dans l'en-tête X-Shopify-Shop-Domain de ses webhooks
# (ex. wn02qe-0w.myshopify.com) : ce n'est PAS toujours le nom court visible
# dans l'URL de l'admin. Plusieurs domaines d'une même boutique peuvent être
# déclarés, séparés par des virgules (liste blanche ; le premier sert aux
# appels à l'API Admin).
SHOPIFY_STORE_DOMAIN=
# OBLIGATOIRE — Client ID de l'application (Dev Dashboard)
SHOPIFY_CLIENT_ID=
# OBLIGATOIRE — Client Secret de l'application (Dev Dashboard)
SHOPIFY_CLIENT_SECRET=
# Facultatif — version d'API Admin (format YYYY-MM, défaut : 2026-01)
SHOPIFY_API_VERSION=

# --- Fallbacks LEGACY (uniquement pour une ANCIENNE application
# --- personnalisée créée dans l'admin de la boutique — ne pas utiliser
# --- pour une nouvelle installation) :
# Token permanent shpat_… (remplacé par le Client Credentials Grant)
SHOPIFY_ADMIN_ACCESS_TOKEN=
# Ancienne clé de signature de la section Notifications (remplacée par le
# Client Secret)
SHOPIFY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Google Sheets — lecture du récapitulatif (voir docs/RECAP_GOOGLE_SHEETS.md)
#
# TRUST AI lit le fichier en LECTURE SEULE, côté serveur, avec un « compte de
# service » Google. Aucune de ces deux valeurs n'est envoyée au navigateur.
# Sans elles, l'application se compile et fonctionne : la page
# « Configurer le récapitulatif » affiche simplement que la connexion Google
# n'est pas encore en place.
# ---------------------------------------------------------------------------
# Adresse du compte de service (…@….iam.gserviceaccount.com). C'est cette
# adresse que l'on partage EN LECTEUR sur le Google Sheets.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Clé privée du compte de service, telle qu'elle apparaît dans le fichier JSON
# téléchargé (« private_key »). Les retours à la ligne peuvent être laissés
# sous la forme \n : l'application les rétablit.
# À COLLER UNIQUEMENT dans Vercel (Settings → Environment Variables) ou dans
# .env.local — jamais dans ce fichier, jamais dans une conversation.
GOOGLE_PRIVATE_KEY=

# OpenAI (agent IA : propositions fournisseurs, relances, alertes — phase suivante)
OPENAI_API_KEY=
